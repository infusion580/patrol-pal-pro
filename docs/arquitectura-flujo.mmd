graph LR
    subgraph GUARDIA["Perfil Guardia (PWA)"]
        A1[Login / Sesion unica]
        A2[ShiftControl: inicio y fin de turno]
        A3[Rondines: QR + GPS + foto]
        A4[Pendientes del puesto]
        A5[Visitas y Reporte de turno]
        A6[Geocerca global + Boton de panico]
        A7[Colas offline: localStorage + IndexedDB]
    end

    subgraph COM["Modulo Comunicacion"]
        B1[Chat 1 a 1 operativo]
        B2[Chat RH confidencial por folio]
        B3[Centro de notificaciones]
        B4[Web Push VAPID / Service Worker]
    end

    subgraph SUP["Perfil Supervisor"]
        C1[Dashboard operativo en vivo]
        C2[Mapa Leaflet en tiempo real]
        C3[Validacion de reportes con feedback]
        C4[Asistencias, faltas y relevos]
        C5[Metricas, KPIs y exportes PDF/Excel]
    end

    subgraph ADM["Perfil Admin"]
        E1[Alta de servicios y puntos de rondin]
        E2[Generacion de NIPs de registro]
        E3[Asignacion de servicio principal]
        E4[Configuracion de alarmas de rondin]
        E5[Branding: logo y paleta]
        E6[Config de datos visibles al cliente]
        E7[Bitacora de auditoria]
    end

    subgraph RH["Perfil RH"]
        F1[Folios de chat confidencial]
        F2[Turnos extra, prestamos y vacaciones]
        F3[Estatus laboral y ausencias]
        F4[Relevos no cubiertos + PDF]
    end

    subgraph CLI["Perfil Cliente"]
        G1[Dashboard de solo lectura]
        G2[KPIs, graficas y semaforo]
        G3[Reporte filtrado por config admin]
        G4[Export PDF / Excel con marca]
    end

    subgraph BE["Backend - Lovable Cloud"]
        D1[(Postgres + RLS por rol)]
        D2[Auth + roles via NIP]
        D3[Storage privado: evidencias, visitas, avatars]
        D4[Realtime: canales compartidos]
        D5[Edge Functions + pg_cron]
        D6[(audit_log append-only)]
    end

