# Copia este archivo a scripts/migrate.env y completa los valores.
# NO lo subas al repositorio con credenciales reales.

# ---- Origen (Lovable Cloud / Supabase) ----
SRC_HOST=db.xxxxxxxx.supabase.co
SRC_PORT=5432
SRC_USER=postgres
SRC_PASSWORD=
SRC_DB=postgres

# ---- Destino (servidor propio) ----
DST_HOST=10.0.0.20
DST_PORT=5432
DST_USER=postgres
DST_PASSWORD=
DST_DB=defender

# ---- Opciones ----
APP_SCHEMAS=public     # separa con comas si migras más esquemas
MIGRATE_AUTH=true      # migra auth.users y auth.identities (hashes bcrypt)
PGSSLMODE=require      # require | prefer | disable
JOBS=4
