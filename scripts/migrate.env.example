# Copia este archivo a scripts/migrate.env y completa los valores.
# NO lo subas al repositorio con credenciales reales.

# ---- Origen (Lovable Cloud / Supabase) ----
SRC_HOST=db.xxxxxxxx.supabase.co
SRC_PORT=5432
SRC_USER=postgres
SRC_PASSWORD=
SRC_DB=postgres

# ---- Destino (servidor propio) ----
DST_HOST=10.0.0.20
DST_PORT=5432
DST_USER=postgres
DST_PASSWORD=
DST_DB=defender

# ---- Opciones ----
APP_SCHEMAS=public     # separa con comas si migras más esquemas
MIGRATE_AUTH=true      # migra auth.users y auth.identities (hashes bcrypt)
PGSSLMODE=require      # require | prefer | disable
JOBS=4

# --- Storage (fotos, videos y adjuntos) --------------------------------------
MIGRATE_STORAGE=true
# Vacío = todos los buckets del origen. Ej: avatars,evidencias,visitas,pendientes,branding,backups
STORAGE_BUCKETS=
SRC_S3_ENDPOINT=https://<proyecto>.storage.supabase.co/storage/v1/s3
SRC_S3_REGION=us-east-1
SRC_S3_ACCESS_KEY=********
SRC_S3_SECRET_KEY=********
DST_S3_ENDPOINT=https://minio.midominio.com
DST_S3_REGION=us-east-1
DST_S3_ACCESS_KEY=********
DST_S3_SECRET_KEY=********
# Reescritura de enlaces guardados en la base de datos (opcional pero recomendado)
SRC_PUBLIC_STORAGE_URL=https://<proyecto>.supabase.co/storage/v1/object/public
DST_PUBLIC_STORAGE_URL=https://minio.midominio.com
